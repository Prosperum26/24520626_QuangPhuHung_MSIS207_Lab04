# Sao chép thành .env (cùng thư mục), không commit .env.
# Server đọc: PORT, CLIENT_ORIGIN, RESPONSE_DELAY_MS. Client (Vite) chỉ đọc biến VITE_*.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Độ trễ giả (ms) để kiểm chứng huỷ request bằng DevTools; 0 = tắt
RESPONSE_DELAY_MS=0
VITE_API_BASE=http://localhost:3001
